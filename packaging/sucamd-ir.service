[Unit]
Description=Surface Laptop Ultra IR camera (raw IR sensor -> v4l2loopback "Surface IR Camera")
After=systemd-modules-load.service

[Service]
ExecStart=/usr/local/bin/sucamd --ir
Restart=always
RestartSec=3
DynamicUser=yes
SupplementaryGroups=video
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
